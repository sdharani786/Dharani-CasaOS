<!-- MISC -->
<h2>📦 Misc</h2>
<div class="grid">
    <a class="tile" href="http://archiveboc.local" data-url="http://archiveboc.local">
        <div class="status loading">...</div>
        <i class="fa-solid fa-box-archive"></i><span>ArchiveBOC</span>
    </a>
</div>

<script>
async function checkStatus(tile) {
    const url = tile.getAttribute("data-url");
    const statusEl = tile.querySelector(".status");

    try {
        const controller = new AbortController();
        setTimeout(() => controller.abort(), 3000);

        await fetch(url, { method: "GET", signal: controller.signal });

        statusEl.textContent = "Online";
        statusEl.className = "status online";
    } catch {
        statusEl.textContent = "Offline";
        statusEl.className = "status offline";
    }
}

function runStatusChecks() {
    document.querySelectorAll(".tile").forEach(tile => {
        const statusEl = tile.querySelector(".status");
        statusEl.textContent = "...";
        statusEl.className = "status loading";
        checkStatus(tile);
    });
}

runStatusChecks();
setInterval(runStatusChecks, 10000);
</script>

</body>
</html>
